# ==============================
# Application
# ==============================
APP_NAME=Billing Automation Platform
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# ==============================
# Database
# ==============================
POSTGRES_USER=billing_user
POSTGRES_PASSWORD=billing_pass
POSTGRES_DB=billing_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://billing_user:billing_pass@db:5432/billing_db

# ==============================
# Security / JWT
# ==============================
SECRET_KEY=change_this_to_a_long_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ==============================
# Redis / Celery
# ==============================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ==============================
# Rate Limiting (authentication endpoints)
# ==============================
# Reuses the existing Redis instance -- no new infrastructure. Applies
# to POST /auth/register, /auth/login, /auth/token, and /auth/refresh,
# the endpoints most exposed to credential-stuffing/brute-force
# attempts. Fails open (no limiting) if Redis is unreachable, so an
# outage of this auxiliary system never blocks real logins.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX_ATTEMPTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ==============================
# Billing Scheduler
# ==============================
BILLING_SCHEDULER_INTERVAL_SECONDS=3600

# ==============================
# Tax Calculation (Module 2)
# ==============================
# Per-country tax rate as a decimal fraction, keyed by ISO 3166-1
# alpha-2 country code. Uses sane defaults if left unset; override as
# a JSON object string if you need different rates, e.g.:
# TAX_RATES={"US": 0.08, "IN": 0.18, "GB": 0.20}
DEFAULT_TAX_RATE=0.0

# ==============================
# Mock Payment Gateway (Module 2)
# ==============================
PAYMENT_GATEWAY_SUCCESS_RATE=0.9

# ==============================
# Payment Webhooks (Module 2)
# ==============================
# Leave PAYMENT_WEBHOOK_URL unset for local/dev use: the webhook
# sender will invoke the handler in-process instead of over HTTP.
# Set it to an externally reachable URL (e.g.
# https://your-domain.com/api/v1/webhooks/payment) to test real
# HTTP delivery with HMAC signature verification.
PAYMENT_WEBHOOK_URL=
WEBHOOK_SECRET=change_this_webhook_secret_in_production
WEBHOOK_MAX_RETRIES=3

# ==============================
# Email Notifications (Module 2 + Phase 6B)
# ==============================
# Leave SMTP_HOST unset for local/dev use: every notification email
# (welcome, profile updated, subscription lifecycle, plan changes,
# invoices, payments, refunds, trial-ending/renewal reminders) is
# logged instead of sent. Set SMTP_HOST (and credentials, if your
# provider needs them) to send real HTML emails via the existing
# Celery + Redis task queue. Any SMTP-compatible provider works
# (SendGrid, Amazon SES, Resend, etc. all expose an SMTP relay) --
# no provider-specific SDK integration needed.
NOTIFICATIONS_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
NOTIFICATION_FROM_EMAIL=billing@cineverse.example.com
COMPANY_NAME=CineVerse
COMPANY_LOGO_URL=https://cineverse.example.com/logo.png
SUPPORT_EMAIL=support@cineverse.example.com

# How many days before a trial ends / a billing cycle renews to send
# a reminder email. Each subscription only ever gets one reminder per
# trial/cycle regardless of how often the scheduler runs (deduped via
# the audit log).
TRIAL_ENDING_REMINDER_DAYS=3
RENEWAL_REMINDER_DAYS=3

# ==============================
# Logging
# ==============================
LOG_LEVEL=INFO
