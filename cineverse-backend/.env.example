
# ==============================
# Application
# ==============================
APP_NAME=Billing Automation Platform
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# ==============================
# Database
# ==============================
POSTGRES_USER=billing_user
POSTGRES_PASSWORD=billing_pass
POSTGRES_DB=billing_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://billing_user:billing_pass@db:5432/billing_db

# ==============================
# Security / JWT
# ==============================
SECRET_KEY=change_this_to_a_long_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ==============================
# Redis / Celery
# ==============================
# Leave REDIS_URL empty for local Docker Redis.
# Set it to your Upstash rediss:// URL in production.
REDIS_URL=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ==============================
# Rate Limiting
# ==============================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX_ATTEMPTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# ==============================
# Celery
# ==============================
# Local Docker defaults. Override with Upstash URLs in production.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ==============================
# Billing Scheduler
# ==============================
BILLING_SCHEDULER_INTERVAL_SECONDS=3600
RETRY_SCHEDULER_INTERVAL_SECONDS=3600
TRIAL_ENDING_REMINDER_DAYS=3
RENEWAL_REMINDER_DAYS=3

# ==============================
# Tax Calculation
# ==============================
# TAX_RATES={"US": 0.08, "IN": 0.18, "GB": 0.20}
DEFAULT_TAX_RATE=0.0

# ==============================
# Mock Payment Gateway
# ==============================
PAYMENT_GATEWAY_SUCCESS_RATE=0.9

# ==============================
# Payment Webhooks
# ==============================
PAYMENT_WEBHOOK_URL=
WEBHOOK_SECRET=change_this_webhook_secret_in_production
WEBHOOK_MAX_RETRIES=3

# ==============================
# Logging
# ==============================
LOG_LEVEL=INFO

# ==============================
# Email Notifications
# ==============================
NOTIFICATIONS_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
NOTIFICATION_FROM_EMAIL=billing@cineverse.example.com

# ==============================
# Company Information
# ==============================
COMPANY_NAME=CineVerse
COMPANY_LOGO_URL=https://cineverse.example.com/logo.png
SUPPORT_EMAIL=support@cineverse.example.com

# ==============================
# Invoice Configuration
# ==============================
COMPANY_LOGO_PATH=
COMPANY_ADDRESS=123 Market Street, Suite 400, San Francisco, CA 94105, USA
COMPANY_PHONE=+1 (415) 555-0100
COMPANY_EMAIL=billing@cineverse.example.com
COMPANY_WEBSITE=https://cineverse.example.com
FRONTEND_BASE_URL=https://app.cineverse.example.com
COMPANY_TAX_ID=TAX-ID-0000000
SUPPORT_PHONE=+1 (415) 555-0199
PAYMENT_TERMS=Payment is due within the invoice's stated due date. Late payments may result in service suspension.
REFUND_POLICY=Refunds are issued at our discretion in accordance with our published refund policy. Contact support for assistance.

# ==============================
# CORS
# ==============================
# Replace with your actual frontend origin in production.
CORS_ORIGINS=["*"]
